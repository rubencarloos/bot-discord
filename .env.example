# Copia este archivo como .env (solo para probar en tu PC). En Railway se ponen como "Variables".
DISCORD_TOKEN=pega_aqui_el_token_del_bot
CLIENT_ID=pega_aqui_el_application_id
# Opcional: ID de tu servidor. Con él, los comandos aparecen al instante en ese servidor.
GUILD_ID=
# Opcional: servidor de Minecraft en exaroton (whitelist automática al aceptar inscripciones)
# Clave en exaroton.com > Cuenta > API. ID del servidor: aparece en la web del servidor (exaroton.com/server/#ID)
EXAROTON_TOKEN=
EXAROTON_SERVER_ID=
